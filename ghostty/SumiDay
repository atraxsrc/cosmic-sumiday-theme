# SumiDay for Ghostty, part of cosmic-sumiday-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = SumiDay
# or, with the Sumi half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Sumi,light:SumiDay

background = #EDE8DE
foreground = #1C1B19

cursor-color = #566658
cursor-text = #EDE8DE

selection-background = #D9D2C5
selection-foreground = #1C1B19

split-divider-color = #D9D2C5
unfocused-split-fill = #EDE8DE

