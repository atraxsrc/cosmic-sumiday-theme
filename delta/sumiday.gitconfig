# SumiDay for delta (the git diff pager), part of cosmic-sumiday-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat SumiDay theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/sumiday.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = sumiday

[delta "sumiday"]
    light = true
    syntax-theme = SumiDay
    navigate = true
    line-numbers = true

    file-style = bold "#566658"
    file-decoration-style = "#D9D2C5" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#D9D2C5" box
    hunk-header-file-style = "#54645A"
    hunk-header-line-number-style = "#745E30"

    minus-style = "#AC3320" "#F7F3EB"
    minus-emph-style = bold "#EDE8DE" "#AC3320"
    minus-non-emph-style = "#AC3320" "#F7F3EB"
    plus-style = "#5D635A" "#F7F3EB"
    plus-emph-style = bold "#EDE8DE" "#5D635A"
    plus-non-emph-style = "#5D635A" "#F7F3EB"
    zero-style = syntax
    whitespace-error-style = "#EDE8DE" "#A23A2A"

    line-numbers-left-style = "#D9D2C5"
    line-numbers-right-style = "#D9D2C5"
    line-numbers-minus-style = "#AC3320"
    line-numbers-plus-style = "#5D635A"
    line-numbers-zero-style = "#979590"

    commit-style = bold "#745E30"
    commit-decoration-style = "#D9D2C5" box
    blame-palette = "#EDE8DE #F7F3EB #E4DED2"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#5D635A"
    merge-conflict-theirs-diff-header-style = bold "#A23A2A"
